API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token

# Use a numeric channel ID like -1001234567890 or a public @username.
# Private channels should use the full -100... channel ID, not a plain positive number.
# The bot must be an admin in this channel with permission to post messages.
ARCHIVE_CHAT=@your_archive_channel

# Reply to a message in a group with /archive to copy it to ARCHIVE_CHAT.
ARCHIVE_COMMAND=archive
